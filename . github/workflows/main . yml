      - name: Write Bridge.kt
        run: |
          cat > app/src/main/java/com/ckauto/app/Bridge.kt << 'EOF'
          package com.ckauto.app

          import android.content.Context
          import android.webkit.JavascriptInterface

          class Bridge(private val c: Context) {
              @JavascriptInterface
              fun getSms(): String = Store.take(c)

              @JavascriptInterface
              fun startUssd(id: String, steps: String) {
                  UssdEngine.start(id, steps)
              }

              @JavascriptInterface
              fun failUssd(id: String, why: String) {
                  UssdEngine.fail(id, why)
              }

              @JavascriptInterface
              fun isAccessibilityEnabled(): Boolean = UssdService.enabled(c)
          }
          EOF

